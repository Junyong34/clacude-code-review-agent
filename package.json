{
  "name": "bitbucketwebhooksserver",
  "version": "1.0.0",
  "description": "Bitbucket 온프레미스 PR을 위한 Claude 코드리뷰 에이전트",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --import tsx --test $(find test -name '*.test.js' -o -name '*.test.ts')",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/server.js",
    "dev": "DOTENV_CONFIG_PATH=.env.local node --import tsx -r dotenv/config ./src/server.ts",
    "prod": "DOTENV_CONFIG_PATH=.env.production node --import tsx -r dotenv/config ./src/server.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "https": "^1.0.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
