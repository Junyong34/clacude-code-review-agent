# Node.js 24 이상, 25 미만. 실제 비밀 값은 .env.local / .env.production에만 저장하세요.
# Bitbucket Server / Data Center: 단일 저장소의 OPEN PR collection URL
BITBUCKET_API_URL=https://bitbucket.example.com/rest/api/1.0/projects/DEMO/repos/example-app/pull-requests?state=OPEN
BITBUCKET_AUTH_HEADER=
BITBUCKET_BOT_AUTH_HEADER=
BITBUCKET_BOT_SLUG=review-bot

ANTHROPIC_API_KEY=
# 사용하는 Anthropic 계정/프록시가 지원하는 모델 ID로 변경하세요.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_STREAM_CONCURRENCY=4
# 선택: Anthropic 호환 프록시 주소 (SDK에서 읽음)
# ANTHROPIC_BASE_URL=https://ai.example.com

SLACK_WEBHOOK_URL_PRD=
SLACK_WEBHOOK_URL_QA=
SLACK_TARGET_USERS=
# 선택: 미설정이면 메시지에 링크를 넣지 않음
JIRA_BASE_URL=
DEPLOY_CHECKLIST_URL=

# 서버 시작 시 자동 예약만 제어. 수동 실행/시작 API는 별도로 동작합니다.
ENABLE_DAILY_PR_CRON=false
CRON_EXPRESSION=00 09 * * 1-5
ENABLE_WEEKLY_BLOG_CRON=false
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
CONFLUENCE_SPACE_KEY=
MAX_W=45

# 선택: CRG를 쓰려면 기존 clone, git 접근 권한, code-review-graph CLI가 필요
CODE_REVIEW_CONTEXT_CLONE_PATH=
CODE_REVIEW_MASTER_WORKTREE_DIR=.worktrees/code-review-master
CODE_REVIEW_CRG_ONLY=false
# 사설 인증서 사용 시 PEM CA 파일 지정 (TLS 검증은 유지)
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
